<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.eventcraft.controllers.OffreController">
    <children>
        <AnchorPane fx:id="affiche_listOffre" layoutX="5.0" layoutY="3.0" prefHeight="485.0" prefWidth="686.0">
            <children>
                <Pane fx:id="liste_Offre" layoutX="8.0" layoutY="12.0" prefHeight="656.0" prefWidth="1070.0"
                      style="-fx-background-color: #FFFDF6; -fx-padding: 20px; -fx-border-color: #ccc; -fx-border-radius: 10px; -fx-background-radius: 10px;">

                    <ImageView fitHeight="85.0" fitWidth="126.0" layoutX="903.0" layoutY="14.0" pickOnBounds="true"
                               preserveRatio="true">
                        <image>
                            <Image url="@images/logo.png"/>
                        </image>
                    </ImageView>

                    <Text layoutX="100.0" layoutY="57.0" strokeType="OUTSIDE" strokeWidth="0.0"
                          style="-fx-font-size: 35px; -fx-font-weight: bold; -fx-fill: #4A4A4A; -fx-font-family: 'Segoe UI', Tahoma, Geneva, sans-serif;"
                          text="Liste des Offres"/>

                    <Button layoutX="740.0" layoutY="601.0" mnemonicParsing="false" onAction="#handleAddOffre"
                            style="-fx-background-color: #8B7355; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 20px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 200; -fx-font-family: 'Bahnschrift';"
                            text="Ajouter Offre"/>

                    <Button layoutX="500.0" layoutY="601.0" mnemonicParsing="false" onAction="#handleDemandeOffre"
                            style="-fx-background-color: #8B7355; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 20px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 200; -fx-font-family: 'Bahnschrift';"
                            text="Faire une Demande"/>

                    <ListView fx:id="offreListView" layoutX="14.0" layoutY="74.0" prefHeight="500.0" prefWidth="900.0" style="-fx-background-color: #FFFDF6;">
                        <!-- Custom ListCell will handle the rendering of each item, including the rating slider -->
                    </ListView>
                </Pane>
                <ImageView fitHeight="47.0" fitWidth="81.0" layoutX="451.0" layoutY="13.0" pickOnBounds="true"
                           preserveRatio="true"/>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>

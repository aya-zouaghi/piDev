<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eventcraft.controller.AdminController"
            stylesheets="@/styles/styles.css"
            styleClass="root">
    <left>
        <VBox styleClass="left-panel">
            <VBox styleClass="logo">
                <ImageView fx:id="logoImage" fitHeight="120.0" fitWidth="120.0" preserveRatio="true">
                    <image>
                        <Image url="/images/logo.png"/>
                    </image>
                </ImageView>
                <Label text="EventCraft" styleClass="company-label"/>
                <Label text="Crafting Memories" styleClass="slogan-label"/>
            </VBox>
            <VBox styleClass="nav-section">
                <Button text="Back" onAction="#handleBackNavigation" styleClass="nav-button"/>

                <Button text="Edit Profile" onAction="#handleEditProfileNavigation" styleClass="nav-button"/>
                <Button text="Notifications" styleClass="nav-button"/>
                <Button text="Password" onAction="#handlePassword" styleClass="nav-button"/>
                <Button text="Settings" styleClass="nav-button"/>
                <Button text="Admin Dashboard" onAction="#handleAdminDashboard" styleClass="nav-button"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="form-panel">
            <VBox styleClass="profile-header">
                <Label fx:id="userNameLabel" styleClass="title-label"/>
                <Label text="Profile Settings" styleClass="info-label"/>
            </VBox>
            <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                <Label text="Profile Details" styleClass="title-label"/>
                <ListView fx:id="profileDetailsList" styleClass="profile-list" VBox.vgrow="ALWAYS"/>
            </VBox>
            <HBox alignment="CENTER">
                <Button text="Logout" onAction="#handleLogout" styleClass="logout-button"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>

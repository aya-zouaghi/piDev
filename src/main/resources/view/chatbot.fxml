<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventcraft.controller.ChatbotController" spacing="10" style="-fx-padding: 20; -fx-background-color: #F5F5F5;">
    <!-- Zone d'affichage des messages -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox fx:id="chatContainer" spacing="10" style="-fx-padding: 10; -fx-background-color: #FFFFFF; -fx-border-radius: 10; -fx-background-radius: 10;"/>
    </ScrollPane>

    <!-- Champ de texte pour la question de l'utilisateur -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <TextField fx:id="userInput" promptText="Entrez votre message ici"
                   style="-fx-background-color: #FFFFFF; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-padding: 10; -fx-border-radius: 10; -fx-pref-height: 40px; -fx-pref-width: 300px;"/>
        <Button fx:id="sendButton" text="Envoyer" onAction="#sendMessage"
                style="-fx-background-color: #CBA979; -fx-text-fill: #FFFFFF; -fx-border-radius: 10; -fx-font-size: 14px; -fx-pref-height: 40px; -fx-pref-width: 100px; -fx-padding: 10; -fx-cursor: hand;"/>
    </HBox>
</VBox>
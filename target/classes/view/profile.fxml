<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.eventcraft.controller.ProfileController" stylesheets="/styles/styles.css">
    <left>
        <VBox spacing="10.0" styleClass="left-panel">
            <BorderPane.margin>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </BorderPane.margin>
            <ImageView fx:id="logoImage" fitHeight="100.0" fitWidth="100.0" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <Button text="Edit Profile" onAction="#handleEditProfileNavigation" styleClass="submit-button"/>
            <Button text="Notifications" styleClass="submit-button"/>
            <Button text="Password" onAction="#handlePassword" styleClass="submit-button"/>
            <Button text="Reclamation" onAction="#openReclamation" styleClass="submit-button"/>
            <Button text="Privacy Policy" styleClass="submit-button"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label fx:id="userNameLabel" styleClass="info-label"/>
            <Label text="Profile Settings" styleClass="title-label"/>
            <Label text="Profile details" styleClass="info-label"/>
            <ListView fx:id="profileDetailsList" VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="submit-button"/>
        </VBox>
    </center>
</BorderPane>

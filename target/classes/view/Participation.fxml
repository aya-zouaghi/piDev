<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.eventcraft.controller.ParticipationController" stylesheets="/styles/styles.css">
    <left>
        <VBox spacing="10.0" styleClass="left-panel">
            <BorderPane.margin>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </BorderPane.margin>
            <ImageView fx:id="logoImage" fitHeight="100.0" fitWidth="100.0" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <Button text="Ajouter Participant" onAction="#handleAjouter" styleClass="submit-button"/>
            <Button text="Supprimer Participant" onAction="#handleSupprimer" styleClass="submit-button"/>
            <Button text="Modifier Participant" onAction="#handleModifier" styleClass="submit-button"/>
        </VBox>
    </left>
    <center>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Button text="Quitter" onAction="#handleQuitter" GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.columnSpan="2" styleClass="submit-button"/>
        </GridPane>
    </center>
</BorderPane>

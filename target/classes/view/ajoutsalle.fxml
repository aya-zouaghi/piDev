<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="10" style="-fx-padding: 20; -fx-border-color: #8D598F; -fx-border-width: 1px;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventcraft.controller.AddSalleController">
    <!-- Titre avec couleur #8D598F -->
    <Label text="Ajouter une nouvelle salle" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8D598F;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom de la salle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomSalleField" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: transparent; -fx-border-color: #8D598F; -fx-border-width: 1px;"/>

        <Label text="Capacité:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="capaciteField" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: transparent; -fx-border-color: #8D598F; -fx-border-width: 1px;"/>

        <Label text="Équipement:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="equipementField" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-color: transparent; -fx-border-color: #8D598F; -fx-border-width: 1px;"/>

        <Label text="Images:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <VBox GridPane.rowIndex="3" GridPane.columnIndex="1" spacing="10">
            <Button text="Choisir des images" onAction="#handleChooseImagesButton" style="-fx-background-color: #B19BB2;"/>
            <ListView fx:id="imagesListView"/>
        </VBox>

        <Label text="Localisation:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="locationSalleField" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-background-color: transparent; -fx-border-color: #8D598F; -fx-border-width: 1px;"/>

        <Label text="Qualité:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="qualiteComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-background-color: transparent; -fx-border-color: #8D598F; -fx-border-width: 1px;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Fabuleux"/>
                    <String fx:value="Superbe"/>
                    <String fx:value="Exceptionnel"/>
                    <String fx:value="Très bien"/>
                    <String fx:value="Standard"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="Prix:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="prixField" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-background-color: transparent; -fx-border-color: #8D598F; -fx-border-width: 1px;"/>
    </GridPane>

    <!-- Boutons avec couleur de fond #CBA979 -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Ajouter" onAction="#handleAddButton" style="-fx-background-color: #CBA979; -fx-text-fill: white;"/>
        <Button text="Annuler" onAction="#handleCancelButton" style="-fx-background-color: #CBA979; -fx-text-fill: white;"/>
    </HBox>
</VBox>
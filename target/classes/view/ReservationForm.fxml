<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventcraft.controller.ReservationFormController"
      spacing="20" alignment="CENTER" style="-fx-padding: 30; -fx-background-color: #f4f4f4;">

    <!-- Titre -->
    <Label text="Demandez maintenant votre Réservation !" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Date -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Date Debut :" style="-fx-font-size: 16px;" />
        <DatePicker fx:id="dateDebutPicker" style="-fx-font-size: 14px;" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Date Fin :" style="-fx-font-size: 16px;" />
        <DatePicker fx:id="dateFinPicker" style="-fx-font-size: 14px;" />
    </HBox>

    <!-- Bouton "Confirmer ma réservation" -->
    <Button fx:id="confirmButton" text="Confirmer ma réservation" onAction="#handleConfirmButton" style="-fx-background-color: #CBA979; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 30px;" />
</VBox>
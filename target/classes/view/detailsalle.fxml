<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.image.Image?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventcraft.controller.DetailsSalleController">

    <!-- Top Bar -->
    <top>
        <HBox fx:id="menuBar" spacing="20" alignment="CENTER_LEFT"
              style="-fx-padding: 10; -fx-background-color: #CBA979;">
            <!-- Bouton Retour -->
            <!-- Bouton Retour avec une image -->
            <Button fx:id="backButton" onAction="#handleBackButton"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <graphic>
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <image>
                            <Image url="@/images/arrow-left.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>            <Region HBox.hgrow="ALWAYS" />
            <Button text="Déconnexion" fx:id="logoutBtn" onAction="#handleLogout"
                    style="-fx-border-color: #FFFFFF; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-border-width: 1px; -fx-padding: 8 16; -fx-background-color: transparent;" />
            <Button fx:id="chatButton" text="Chat AI" onAction="#openChatWindow" style=" ;-fx-text-fill: white;-fx-background-color: #8D598F;"/>
        </HBox>
    </top>

    <!-- Left Side Navigation -->
    <left>
        <VBox fx:id="sidenav" prefWidth="180" minWidth="180" maxWidth="180"
              style="-fx-background-color: #CBA979; -fx-transition: 0.5s;" alignment="TOP_LEFT" >
            <VBox alignment="TOP_CENTER">
                <ImageView fx:id="logoImageView" fitWidth="120" fitHeight="120" preserveRatio="true" />
            </VBox>
            <Button text="Evènements" style="-fx-text-fill: white; -fx-font-size: 18px;
               -fx-background-color: transparent;
               -fx-border-color: transparent transparent white transparent;
               -fx-border-width: 0 0 1px 0;
               -fx-padding: 10px;" onAction="#handleAccueilButton"/>
            <Button text="Salles" style="-fx-text-fill: white; -fx-font-size: 18px;
               -fx-background-color: transparent;
               -fx-border-color: transparent transparent white transparent;
               -fx-border-width: 0 0 1px 0;
               -fx-padding: 10px;" onAction="#handleSallesNavigation"/>
            <Button text="Contact" style="-fx-text-fill: white; -fx-font-size: 18px;
               -fx-background-color: transparent;
               -fx-border-color: transparent transparent white transparent;
               -fx-border-width: 0 0 1px 0;
               -fx-padding: 10px;" onAction="#handlecontactButton" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <HBox fx:id="mainContent" spacing="20" style="-fx-padding: 20;">

            <!-- Left: Image -->
            <AnchorPane fx:id="coverImageContainer" style="-fx-background-color: #f2f2f2; -fx-pref-width: 60%;">
                <ImageView fx:id="salleImageView" fitHeight="300" preserveRatio="true" />
            </AnchorPane>

            <!-- Right: Information and Controls -->
            <VBox spacing="20" alignment="TOP_LEFT" style="-fx-padding: 20;">

                <!-- Salle Information -->
                <VBox spacing="10" alignment="TOP_LEFT">
                    <Label fx:id="salleNameLabel" style="-fx-font-size: 30px; -fx-font-weight: bold;" />
                    <Label fx:id="salleLocationLabel" style="-fx-font-size: 22px;" />
                    <Label fx:id="salleCapacityLabel" style="-fx-font-size: 22px;" />
                    <Label fx:id="sallePriceLabel" style="-fx-font-size: 22px; -fx-text-fill: #4CAF50;" />
                </VBox>

                <!-- Date Picker and Reserve Button (Moved below the image and salle info) -->
                <VBox spacing="10" alignment="TOP_LEFT">
                    <Label text="Choisir une date de réservation:" style="-fx-font-size: 20px;" />
                    <DatePicker fx:id="datePicker" style="-fx-font-size: 18px;" onAction="#handleDateSelection"/>
                    <Button fx:id="handleReserverButton" text="Réserver" onAction="#handleReserverButton"
                            style="-fx-text-fill: white;
                                   -fx-font-size: 20px;
                                   -fx-background-color: #98A695;
                                   -fx-max-width: 600px;
                                   -fx-padding: 10px 20px;" />
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>

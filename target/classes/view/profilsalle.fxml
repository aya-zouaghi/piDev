<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventcraft.controller.ProfileSalleController">

    <!-- Top Bar -->
    <top>
        <HBox fx:id="menuBar" spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #CBA979;">
            <!-- Éléments à gauche -->
            <Button fx:id="backButton" onAction="#handleBackButton"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <graphic>
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                        <image>
                            <Image url="@/images/arrow-left.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <!-- Espace flexible pour pousser les boutons à droite -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Boutons à droite -->
            <Button fx:id="afficherReservationsButton" text="Mes Réservations"
                    onAction="#handleAfficherReservationsClick"
                    style="-fx-border-color: #FFFFFF; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-border-width: 1px; -fx-padding: 8 16; -fx-background-color: transparent" />

            <Button text="Déconnexion" fx:id="logoutBtn" onAction="#handleLogout"
                    style="-fx-border-color: #FFFFFF; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-border-width: 1px; -fx-padding: 8 16; -fx-background-color: transparent;" />
            <Button fx:id="chatButton" text="Chat AI" onAction="#openChatWindow" style=" ;-fx-text-fill: white;-fx-background-color: #8D598F;"/>


        </HBox>
    </top>


    <!-- Left Side Navigation -->
    <left>
        <VBox fx:id="sidenav" prefWidth="180" minWidth="180" maxWidth="180"
              style="-fx-background-color: #CBA979; -fx-transition: 0.5s;" alignment="TOP_LEFT" >
            <!-- Logo -->
            <VBox alignment="TOP_CENTER">
                <ImageView fx:id="logoImageView" fitWidth="100" fitHeight="100" preserveRatio="true" />
            </VBox>

            <Button text="Evènements"  style="-fx-text-fill: white; -fx-font-size: 16px;
               -fx-background-color: transparent;
               -fx-border-color: transparent transparent white transparent;
               -fx-border-width: 0 0 1px 0;
               -fx-padding: 10px;" onAction="#handleAccueilButton"/>
            <Button text="Salles"  style="-fx-text-fill: white; -fx-font-size: 16px;
               -fx-background-color: transparent;
               -fx-border-color: transparent transparent white transparent;
               -fx-border-width: 0 0 1px 0;
               -fx-padding: 10px;" onAction="#handleSallesNavigation"/>
            <Button text="Contact"  style="-fx-text-fill: white; -fx-font-size: 16px;
               -fx-background-color: transparent;
               -fx-border-color: transparent transparent white transparent;
               -fx-border-width: 0 0 1px 0;
               -fx-padding: 10px;" onAction="#handlecontactButton" />
        </VBox>
    </left>

    <!-- Contenu principal au centre -->
    <center>
        <VBox fx:id="mainContent" spacing="10" alignment="CENTER" style="-fx-padding: 20;">
            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #BBC4B8; -fx-padding: 10px; -fx-pref-width: 900px;">
                <TextField fx:id="searchField" promptText="Rechercher une salle..." style="   -fx-pref-width: 500px;
    -fx-pref-height: 40px;   -fx-font-family: Arial;
    -fx-background-color: transparent;
    -fx-border-color: white;
    -fx-border-width: 1px;
    -fx-pref-width: 400px; -fx-padding: 5px;"/>
                <ComboBox fx:id="capacityFilter" promptText="Capacité" styleClass="combo-box" style="-fx-pref-width: 200px;
            -fx-pref-height: 40px;
            -fx-padding: 5px;
            -fx-font-size: 14px;
            -fx-font-family: Arial;
            -fx-background-color: transparent;
            -fx-border-color: white;
            -fx-border-width: 1px;
            -fx-text-fill: #CBA979;  "/>
                <ComboBox fx:id="qualityFilter" promptText="Qualité" styleClass="combo-box" style="  -fx-pref-width: 200px;
            -fx-pref-height: 40px;
            -fx-padding: 5px;
            -fx-font-size: 14px;
            -fx-font-family: Arial;
            -fx-background-color: transparent;
            -fx-border-color: white;
            -fx-border-width: 1px;
            -fx-text-fill: #CBA979; "/>
                <TextField fx:id="advancedPriceField" promptText="Prix max" style="
    -fx-pref-height: 40px;
    -fx-padding: 5px;
    -fx-font-size: 14px;
    -fx-font-family: Arial;
    -fx-background-color: transparent;
    -fx-border-color: white;
    -fx-border-width: 1px;  "/>

                <Button text="Rechercher"
                        onAction="#onSearch"
                        style= "-fx-pref-width: 200px;
                -fx-pref-height: 40px;   -fx-border-color: #8D598F;-fx-text-fill: #FFFFFF;
         -fx-border-width: 1px;
                -fx-padding: 5px;
                -fx-font-size: 14px;
                -fx-font-family: Arial;

                -fx-background-color: transparent;"/>

                <Button text="Ajouter une.."
                        onAction="#handleAjouterSalleButton"
                        style="  -fx-pref-width: 200px;
                -fx-border-width: 1px;
                -fx-pref-height: 40px;
                -fx-padding: 5px;
                -fx-font-size: 14px;
                -fx-font-family: Arial;
                -fx-background-color: #8D598F;-fx-text-fill: #FFFFFF;"    />
            </HBox>
            <Label text="Vos Salles Publiées"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 20px; -fx-text-fill: #B19BB2;"/>

            <ListView fx:id="listViewSalles" VBox.vgrow="ALWAYS" style="-fx-pref-width: 600px;">
                <VBox spacing="10" alignment="CENTER">
                    <Label fx:id="nameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="detailsLabel" style="-fx-font-size: 14px;"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Modifier"  style="-fx-background-color: #ff6600; -fx-text-fill: white;"/>
                        <Button text="Supprimer" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </ListView>
            <Pagination fx:id="pagination" styleClass="pagination" style="-fx-padding: 10px;"/>

        </VBox>
    </center>

</BorderPane>
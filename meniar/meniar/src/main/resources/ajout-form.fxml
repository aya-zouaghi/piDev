<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@css/style.css"
            style="-fx-background-color: linear-gradient(to bottom right, #f5f5f5, #e8e8e8);"
      prefWidth="800" prefHeight="600"
            minWidth="600" minHeight="400"
      fx:controller="org.example.meniar.controller.FormController">

    <VBox spacing="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" 
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        
        <!-- Modern Header with Gradient -->
        <StackPane>
            <Rectangle width="800" height="120" 
                      style="-fx-fill: linear-gradient(to right, #CBA979, derive(#CBA979, 20%));"/>
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                <Text text="Créer un Forum" 
                      style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: white; -fx-font-family: 'Segoe UI'"/>
            </HBox>
        </StackPane>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                   style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20.0" alignment="CENTER">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                </padding>
                <!-- Form Container -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 15; 
                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
                      maxWidth="700" spacing="20">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                    </padding>
                    
                    <!-- Title Field -->
                    <VBox spacing="8">
                        <Label text="Titre du Forum" 
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <TextField fx:id="titreField" 
                                 style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; 
                                        -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-font-size: 14px;"
                                 promptText="Entrez un titre captivant"/>
                    </VBox>

                    <!-- Description Field -->
                    <VBox spacing="8">
                        <Label text="Description" 
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <TextArea fx:id="descriptionField" 
                                 style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; 
                                        -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-font-size: 14px;"
                                 wrapText="true" prefRowCount="4"
                                 promptText="Décrivez votre sujet en détail"/>
                    </VBox>

                    <!-- Date and User ID in a row -->
                    <HBox spacing="20">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Date de Création" 
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <DatePicker fx:id="datePicker" 
                                      style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; 
                                             -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-font-size: 14px;"/>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="ID Utilisateur" 
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <TextField fx:id="userIdField" 
                                     style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; 
                                            -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-font-size: 14px;"
                                     promptText="Votre ID utilisateur"/>
                        </VBox>
                    </HBox>
</VBox>

                <!-- Buttons Container -->
                <HBox spacing="15.0" alignment="CENTER" maxWidth="700">
                    <padding>
                        <Insets bottom="20.0" top="20.0"/>
                    </padding>
                    <Button text="Retour" onAction="#onReturnClick" 
                            style="-fx-padding: 12 30; -fx-background-radius: 25; -fx-font-size: 14px; 
                                   -fx-background-color: #6C757D; -fx-text-fill: white;
                                   -fx-effect: dropshadow(gaussian, rgba(108,117,125,0.3), 8, 0, 0, 2);"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Créer le Forum" onAction="#onAddForumClick" 
                            style="-fx-padding: 12 30; -fx-background-radius: 25; -fx-font-size: 14px; 
                                   -fx-background-color: #CBA979; -fx-text-fill: white;
                                   -fx-effect: dropshadow(gaussian, rgba(203,169,121,0.3), 8, 0, 0, 2);"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>


<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.eventcraft.controller.EditProfileController" stylesheets="/styles/styles.css">
    <left>
        <VBox spacing="10.0" styleClass="left-panel">
            <BorderPane.margin>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </BorderPane.margin>
            <ImageView fx:id="logoImage" fitHeight="100.0" fitWidth="100.0" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>
            <Button text="Profile" onAction="#handleProfileNavigation" styleClass="submit-button"/>

            <Button text="Notifications" styleClass="submit-button"/>
            <Button text="Password" styleClass="submit-button"/>
            <Button text="Settings" styleClass="submit-button"/>
            <Button text="Privacy Policy" styleClass="submit-button"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label text="Edit Profile" styleClass="title-label"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="info-label"/>
                <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="input-field"/>
                <Label text="Prenom" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="info-label"/>
                <TextField fx:id="prenomField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="input-field"/>
                <Label text="Role" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="info-label"/>
                <TextField fx:id="roleField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="input-field"/>
                <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="info-label"/>
                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="input-field"/>
            </GridPane>
            <Button text="Save" onAction="#saveProfile" styleClass="submit-button"/>
        </VBox>
    </center>
</BorderPane>

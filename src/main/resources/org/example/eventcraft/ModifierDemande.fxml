<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FAF9F6;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.eventcraft.controllers.ModifierDemandeController">

    <VBox alignment="CENTER" layoutX="174.0" layoutY="52.0" spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">

        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #CBA979;" text="Modifier Demande" />

        <TextField fx:id="tf_idDemande" editable="false" promptText="ID Demande" style="-fx-background-color: #98A695; -fx-text-fill: white; -fx-background-radius: 8;" />
        <TextField fx:id="tf_user" promptText="Utilisateur" style="-fx-background-color: #FFFFFF; -fx-border-color: #98A695; -fx-border-radius: 8;" />
        <TextField fx:id="tf_offre" promptText="Offre" style="-fx-background-color: #FFFFFF; -fx-border-color: #98A695; -fx-border-radius: 8;" />
        <TextField fx:id="tf_statutDemande" promptText="Statut" style="-fx-background-color: #FFFFFF; -fx-border-color: #98A695; -fx-border-radius: 8;" />
        <DatePicker fx:id="dp_dateDemande" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBA979; -fx-border-radius: 8;" />

        <Button fx:id="saveButton" onAction="#modifierDemande" style="-fx-background-color: #CBA979; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Sauvegarder" />

    </VBox>

    <!-- Centering the VBox -->
    <AnchorPane.topAnchor>100.0</AnchorPane.topAnchor>
    <AnchorPane.leftAnchor>100.0</AnchorPane.leftAnchor>
    <AnchorPane.rightAnchor>100.0</AnchorPane.rightAnchor>
    <AnchorPane.bottomAnchor>100.0</AnchorPane.bottomAnchor>

</AnchorPane>

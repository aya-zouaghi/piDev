<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.text.Text?>
<AnchorPane fx:id="affiche_listCommande" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventcraft.controller.AfficherCommandeController">
   <children>
      <AnchorPane layoutX="5.0" layoutY="3.0" prefHeight="485.0" prefWidth="686.0">
         <children>
            <Pane fx:id="liste_Commande" layoutX="31.0" layoutY="11.0" prefHeight="459.0" prefWidth="646.0" style="-fx-background-color: #FFFDF6; -fx-padding: 20px; -fx-border-color: #ccc; -fx-border-radius: 10px; -fx-background-radius: 10px;">
               <!-- Logo ImageView -->
               <ImageView fitHeight="85.0" fitWidth="126.0" layoutX="442.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="/images/logo.png" />
                  </image>
               </ImageView>
               <children>

                  <ScrollPane fx:id="Scroll_listeCommande" layoutX="14.0" layoutY="74.0" prefHeight="358.0" prefWidth="550.0" style="-fx-background-color: #FFFDF3; -fx-padding: 20px;">
                     <content>
                        <ListView fx:id="lv_commande" prefHeight="348.0" prefWidth="520.0" />
                     </content>
                  </ScrollPane>
                  <Text layoutX="64.0" layoutY="58.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 35px; -fx-font-weight: bold; -fx-fill: #4A4A4A; -fx-font-family: 'Segoe UI', Tahoma, Geneva, sans-serif;" text="Liste des commandes" />
                  <ImageView fitHeight="47.0" fitWidth="81.0" layoutX="451.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </Pane>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>

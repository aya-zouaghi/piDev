<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox spacing="10" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.AddSalleController">
    <Label text="Ajouter une nouvelle salle" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom de la salle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomSalleField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Capacité:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="capaciteField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Équipement:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="equipementField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Images:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <VBox GridPane.rowIndex="3" GridPane.columnIndex="1" spacing="10">
            <Button text="Choisir des images" onAction="#handleChooseImagesButton"/>
            <ListView fx:id="imagesListView">
                <items>
                    <FXCollections fx:factory="observableArrayList"/>
                </items>
            </ListView>
        </VBox>

        <Label text="Localisation:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="locationSalleField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Qualité:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="qualiteComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Fabuleux"/>
                    <String fx:value="Superbe"/>
                    <String fx:value="Exceptionnel"/>
                    <String fx:value="Très bien"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="Prix:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="prixField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleCancelButton" style="-fx-background-color: #ff6666; -fx-text-fill: white;"/>
        <Button text="Ajouter" onAction="#handleAddButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
</VBox>
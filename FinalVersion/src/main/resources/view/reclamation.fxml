<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eventcraft.controller.ReclamationController"
            stylesheets="/styles/styles.css"
            styleClass="root">
    <left>
        <VBox styleClass="left-panel">
            <VBox styleClass="logo">
                <ImageView fx:id="logoImage" fitHeight="120.0" fitWidth="120.0" preserveRatio="true">
                    <image>
                        <Image url="@/images/logo.png"/>
                    </image>
                </ImageView>
                <Label text="EventCraft" styleClass="company-label"/>
                <Label text="Crafting Memories" styleClass="slogan-label"/>
            </VBox>
            <VBox styleClass="nav-section">
                <Button text="Profile" onAction="#handleProfileNavigation" styleClass="nav-button"/>
                <Button text="View Responses" onAction="#handleViewResponsesNavigation" styleClass="nav-button"/>

                <Button text="View Reclamation" onAction="#handleViewReclamationNavigation" styleClass="nav-button"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="form-panel">
            <Label text="Submit a Reclamation" styleClass="title-label"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="info-label"/>
                <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="input-field"/>
                <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="info-label"/>
                <TextArea fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="input-field"/>
                <Button text="Submit" onAction="#submitReclamation" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" styleClass="submit-button"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>
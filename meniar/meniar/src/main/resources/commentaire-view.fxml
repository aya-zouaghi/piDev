<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@css/style.css"
            style="-fx-background-color: linear-gradient(to bottom right, #f5f5f5, #e8e8e8);"
            prefWidth="800" prefHeight="600"
            minWidth="600" minHeight="400"
      fx:controller="org.example.meniar.controller.CommentaireController">

    <VBox spacing="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" 
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        
        <!-- Modern Header with Gradient -->
        <StackPane>
            <Rectangle width="800" height="120" 
                      style="-fx-fill: linear-gradient(to right, #CBA979, derive(#CBA979, 20%));"/>
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                <Button fx:id="backButton" text="⬅" onAction="#onBackButtonClick"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; 
                               -fx-font-size: 18px; -fx-background-radius: 50%; -fx-min-width: 40;
                               -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;"/>
                <Label fx:id="forumTitleLabel" 
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI'"/>
            </HBox>
        </StackPane>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                   style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20.0" alignment="CENTER">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
                <!-- Forum Description -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 15; 
                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
                      maxWidth="800">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                    </padding>
                    <Text text="Description" 
                          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                    <Label fx:id="forumDescriptionLabel" wrapText="true" 
                           style="-fx-font-size: 14px; -fx-text-fill: #666666;">
                        <padding>
                            <Insets top="10.0"/>
                        </padding>
                    </Label>
                </VBox>

                <!-- Comments Section -->
                <VBox spacing="15" VBox.vgrow="ALWAYS" maxWidth="800">
                    <!-- Comments Header -->
                    <HBox alignment="CENTER_LEFT">
                        <padding>
                            <Insets bottom="10.0"/>
                        </padding>
                        <Text text="Commentaires" 
                              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                    </HBox>

                    <!-- Comments List -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; 
                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
                          VBox.vgrow="ALWAYS">
                        <ListView fx:id="commentsListView" 
                                 style="-fx-background-color: transparent; -fx-background-insets: 0;
                                        -fx-background-radius: 15;"
                                 VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                        </ListView>
                    </VBox>

                    <!-- Add Comment Section -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; 
                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
                          spacing="15">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                        <Text text="Ajouter un commentaire" 
                              style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #333333;"/>
                        <TextArea fx:id="commentTextArea" 
                                 style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; 
                                        -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-font-size: 14px;"
                                 wrapText="true" prefRowCount="3"
                                 promptText="Partagez vos pensées..."/>
                        
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="addCommentButton" text="Publier" onAction="#onAddCommentClick"
                                    style="-fx-padding: 12 30; -fx-background-radius: 25; -fx-font-size: 14px; 
                                           -fx-background-color: #CBA979; -fx-text-fill: white;
                                           -fx-effect: dropshadow(gaussian, rgba(203,169,121,0.3), 8, 0, 0, 2);"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
</VBox>
</AnchorPane>

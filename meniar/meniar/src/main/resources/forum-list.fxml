<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@css/style.css"
            style="-fx-background-color: linear-gradient(to bottom right, #f5f5f5, #e8e8e8);"
            prefWidth="800" prefHeight="600"
            minWidth="600" minHeight="400"
            fx:controller="org.example.meniar.controller.ForumListController">

    <VBox spacing="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" 
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        
        <!-- Modern Header with Gradient -->
        <StackPane>
            <Rectangle width="800" height="120" 
                      style="-fx-fill: linear-gradient(to right, #CBA979, derive(#CBA979, 20%));"/>
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                <Button fx:id="backButton" text="⬅" onAction="#onBackButtonClick"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; 
                               -fx-font-size: 18px; -fx-background-radius: 50%; -fx-min-width: 40;
                               -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40;"/>
                <Text text="Liste des Forums" 
                      style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: white; -fx-font-family: 'Segoe UI'"/>
            </HBox>
        </StackPane>

        <!-- Main Content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                   style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20.0">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                </padding>
                <!-- Search Bar -->
                <HBox style="-fx-background-color: white; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
                      maxWidth="600" alignment="CENTER">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
                    </padding>
                    <TextField fx:id="searchField" promptText="Rechercher un forum..." 
                             style="-fx-background-color: transparent; -fx-font-size: 14px;
                                    -fx-prompt-text-fill: #999999;"
                             HBox.hgrow="ALWAYS"/>
                    <Button fx:id="searchButton" text="🔍" 
                           style="-fx-background-color: transparent; -fx-font-size: 14px;"/>
                </HBox>

                <!-- List Container -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 15; 
                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" 
                      VBox.vgrow="ALWAYS" maxWidth="1000">
                    
                    <ListView fx:id="forumListView" 
                             style="-fx-background-color: transparent; -fx-background-insets: 0;
                                    -fx-padding: 15; -fx-background-radius: 15;"
                             VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>


<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" style="-fx-background-color: #F0C8C6;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.eventcraft.controllers.AjoutDemandeController">

    <VBox alignment="CENTER" layoutX="189.0" layoutY="90.0" spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-padding: 30;                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">

        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #CBA979;" text="Ajouter une Demande" />

        <TextField fx:id="userField" promptText="ID Utilisateur" style="-fx-background-color: #FFFFFF; -fx-border-color: #98A695; -fx-border-radius: 8;" />
        <TextField fx:id="offreField" promptText="ID de l'Offre" style="-fx-background-color: #FFFFFF; -fx-border-color: #98A695; -fx-border-radius: 8;" />
        <TextField fx:id="statutField" promptText="Statut de la Demande" style="-fx-background-color: #FFFFFF; -fx-border-color: #98A695; -fx-border-radius: 8;" />
        <DatePicker fx:id="datePicker" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBA979; -fx-border-radius: 8;" />

        <Button fx:id="addButton" onAction="#handleAddDemande" style="-fx-background-color: #CBA979; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Ajouter la Demande" />

    </VBox>

    <!-- Centering the VBox -->
    <AnchorPane.topAnchor>100.0</AnchorPane.topAnchor>
    <AnchorPane.leftAnchor>100.0</AnchorPane.leftAnchor>
    <AnchorPane.rightAnchor>100.0</AnchorPane.rightAnchor>
    <AnchorPane.bottomAnchor>100.0</AnchorPane.bottomAnchor>

</AnchorPane>

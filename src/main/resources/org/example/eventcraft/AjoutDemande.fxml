<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.eventcraft.controllers.AjoutDemandeController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <!-- Titre de la page -->
    <Label text="Ajouter une Demande" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Champ Utilisateur -->
    <HBox spacing="10.0">
        <Label text="ID Utilisateur:"/>
        <TextField fx:id="userField" promptText="Entrez l'ID de l'utilisateur"/>
    </HBox>

    <!-- Champ Offre -->
    <HBox spacing="10.0">
        <Label text="ID de l'Offre:"/>
        <TextField fx:id="offreField" promptText="Entrez l'ID de l'offre"/>
    </HBox>

    <!-- Champ Statut -->
    <HBox spacing="10.0">
        <Label text="Statut de la Demande:"/>
        <TextField fx:id="statutField" promptText="Entrez le statut de la demande"/>
    </HBox>

    <!-- Sélection de la Date de Demande -->
    <HBox spacing="10.0">
        <Label text="Date de la Demande:"/>
        <DatePicker fx:id="datePicker"/>
    </HBox>

    <!-- Bouton Ajouter Demande -->
    <Button text="Ajouter la Demande" onAction="#handleAddDemande"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px;"/>
</VBox>

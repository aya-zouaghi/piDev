<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.eventcraft.controllers.HelloControler"
            prefHeight="400.0" prefWidth="600.0">

    <!-- Left Side (Colored Background) -->
    <AnchorPane prefWidth="300.0" prefHeight="400.0" style="-fx-background-color: #CBA979;">
    </AnchorPane>

    <!-- Right Side (White Background with Buttons) -->
    <AnchorPane layoutX="300.0" prefWidth="300.0" prefHeight="400.0" style="-fx-background-color: #ffffff;">
        <VBox alignment="CENTER" spacing="20" layoutX="50.0" layoutY="130.0">
            <Button text="Offre" onAction="#openOffre"/>
            <Button text="Demande Offre" onAction="#openDemandeOffre"/>

            <Button fx:id="demandeOffreButton" text="Demande Offre"
                    style="-fx-background-color: #CBA979; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 20px; -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
        </VBox>
    </AnchorPane>

</AnchorPane>

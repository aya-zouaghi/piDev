<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="/styles/styles.css"
      prefWidth="800" prefHeight="600"
      fx:controller="com.eventcraft.controller.FormController">

    <Label text="Modifier le Forum" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Titre du Forum:"/>
    <TextField fx:id="titreField" promptText="Entrez le titre du forum"/>

    <Label text="Description:"/>
    <TextArea fx:id="descriptionField" promptText="Entrez une description"/>

    <Label text="Date de Création:"/>
    <DatePicker fx:id="datePicker"/>


    <Label text="ID Forum:"/>
    <Label fx:id="idForumLabel" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>

    <Button text="Mettre à jour" onAction="#onUpdateForumClick" styleClass="button button-green"/>
</VBox>

